{
  "name": "expoutn-sistemas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-expo.ps1",
    "all:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-expo.ps1 -Dev",
    "all:web": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\start-expo.ps1 -NoTracking",
    "all:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\stop-expo.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "typescript": "~5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2"
  }
}
